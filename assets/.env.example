# Password for /admin (where runs are approved). Change this!
ADMIN_PASSWORD=change-me

# Where data is saved locally when Redis is not configured. Defaults to ./data
# DATA_DIR=data

# On Vercel: add Upstash Redis from the Marketplace (sets KV_REST_API_URL / KV_REST_API_TOKEN)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# On Vercel: GitHub token (Contents: read & write) so admin drawing uploads are committed to the repo.
# Without it, uploads are saved straight to static/images (fine for local dev).
# GITHUB_TOKEN=
# GITHUB_REPO=laojoh/5419-speedcadding
# GITHUB_BRANCH=main
